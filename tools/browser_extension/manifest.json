{
  "manifest_version": 3,
  "name": "Astrorder Session Tabs",
  "version": "1.1.0",
  "permissions": ["tabs", "tabGroups", "scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["session-binding.js"], "run_at": "document_start" }]
}
