{
  "name": "astrorder-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Astrorder desktop workspace",
  "author": "Astrorder",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:go-dev": "electron dev-main.js",
    "check": "node --check main.js && node --check preload.js && node --check service-status.js && node --check service-startup.js",
    "test": "node --test *.test.js",
    "stage:go": "node stage-go-artifacts.js",
    "dist": "npm --prefix ../frontend run build && npm run stage:go && electron-builder --win nsis --config.directories.output=release"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.astrorder.desktop",
    "productName": "Astrorder",
    "afterPack": "./verify-desktop-archive.js",
    "files": [
      "main.js",
      "service-startup.js",
      "preload.js",
      "preview-preload.js",
      "image-preview.html",
      "service-status.html",
      "service-status.js",
      "splash.html"
    ],
    "extraFiles": [
      {
        "from": ".runtime/go-stage",
        "to": "server/bin",
        "filter": [
          "*.exe",
          "astrorder*",
          "helpers/**/*",
          "SHA256SUMS",
          "build-manifest.json"
        ]
      },
      {
        "from": "../connectors/codex/codex-plugin",
        "to": "server/connectors/codex/codex-plugin"
      },
      {
        "from": "../.hermes/plugins/astrorder-hermes",
        "to": "server/.hermes/plugins/astrorder-hermes",
        "filter": ["*.py", "*.yaml"]
      },
      {
        "from": "../connectors/hermes/astrorder_hermes_plugin",
        "to": "server/connectors/hermes/astrorder_hermes_plugin",
        "filter": ["*.py", "py.typed"]
      },
      {
        "from": "../frontend/dist",
        "to": "server/frontend/dist"
      },
      {
        "from": "../frontend/public/favicon.ico",
        "to": "server/frontend/public/favicon.ico"
      }
    ],
    "win": {
      "icon": "../frontend/public/pwa-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
